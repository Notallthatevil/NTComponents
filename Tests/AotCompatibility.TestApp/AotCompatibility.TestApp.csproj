<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
	</PropertyGroup>

	<!-- Ordinary build/test workflows skip native compilation; ensure-aot-build.yml leaves this property unset. -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0' and '$(SkipAotCompatibilityNativeBuild)' != 'true'">
		<WasmBuildNative>true</WasmBuildNative>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net11.0' and '$(SkipAotCompatibilityNativeBuild)' != 'true'">
		<WasmBuildNative>true</WasmBuildNative>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\NTComponents.Analyzers\NTComponents.Analyzers.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\NTComponents\NTComponents.csproj" />
		<!-- .NET 11 Preview 6 fails when the entire library is rooted; the smoke render tree still roots every exercised component. -->
		<TrimmerRootAssembly Include="NTComponents" Condition="'$(TargetFramework)' == 'net10.0'" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
	</ItemGroup>

</Project>

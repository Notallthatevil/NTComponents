<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
		<TestTfmsInParallel>true</TestTfmsInParallel>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AwesomeAssertions" />
		<PackageReference Include="AwesomeAssertions.Analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Playwright" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\LiveTest\LiveTest\LiveTest.csproj" />
		<ProjectReference Include="..\..\NTComponents\NTComponents.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="AwesomeAssertions" />
		<Using Include="Xunit" />
	</ItemGroup>

	<Target Name="BuildDocumentationSiteForBrowserTests" BeforeTargets="Build" Condition="('$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net11.0') and '$(BuildingSolutionFile)' != 'true' and '$(BuildDocumentationSite)' != 'false'">
		<MSBuild Projects="..\..\NTComponents.Site\NTComponents.Site.csproj" Targets="Restore" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework" />
		<MSBuild Projects="..\..\NTComponents.Site\NTComponents.Site.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
	</Target>
</Project>

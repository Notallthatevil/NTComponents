<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*NTComponents\.dll$</ModulePath>
        <ModulePath>.*NTComponents\.Analyzers\.dll$</ModulePath>
        <ModulePath>.*NTComponents\.AspNetCore\.dll$</ModulePath>
        <ModulePath>.*NTComponents\.Extensions\.dll$</ModulePath>
        <ModulePath>.*NTComponents\.MCP\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>

<Project>
  <PropertyGroup>
    <Authors>NT Technologies</Authors>
    <Company>NT Technologies</Company>
    <PackageProjectUrl>https://github.com/Notallthatevil/NTComponents</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Notallthatevil/NTComponents</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Logo.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Logo.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>

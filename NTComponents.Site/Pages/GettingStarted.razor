@page "/getting-started"

<PageTitle>Getting started | NTComponents</PageTitle>

<NTContainerView OnThisPageTitle="Getting started">
    <main class="docs-page docs-guide">
        <DocumentationPageHeader Kicker="Documentation"
                                 Title="Getting started"
                                 Description="Add NTComponents to a Blazor app, give it a Material 3 theme, and render your first component." />

        <div class="docs-callout">
            <strong>Before you start</strong>
            <span>You need the .NET 9, 10, or 11 SDK and a Blazor Web App or standalone Blazor WebAssembly app. The package ships its CSS and JavaScript as static web assets, so you don't need npm or Sass.</span>
        </div>

        <section id="install" class="docs-section">
            <h2>1. Install the package</h2>
            <p>Add the package to your app. In a Blazor Web App that uses WebAssembly or Auto, add it to both the server project and the <code>.Client</code> project.</p>
            <DocsCode Title="Terminal" Code="dotnet add package NTComponents" />
            <p>No app yet? Create a Blazor Web App where every page is interactive on the server, then add the package:</p>
            <DocsCode Title="Terminal" Code="@_newApp" />
            <p>Add the namespaces to <code>_Imports.razor</code>. In a split app, add them to both projects.</p>
            <DocsCode Title="_Imports.razor" Code="@_imports" />
        </section>

        <section id="services" class="docs-section">
            <h2>2. Register the services</h2>
            <p>Call <code>AddNTServices</code> in <code>Program.cs</code>. It registers the toast, snackbar, window, dialog, and browser storage services the components use. In a split Blazor Web App, call it in both projects so prerendering and the browser have the same services.</p>
            <DocsCode Title="Program.cs" Code="@_services" />
        </section>

        <section id="host" class="docs-section">
            <h2>3. Add the head dependencies</h2>
            <p><code>NTHeadDependencies</code> loads the shared theme, fonts, measurements, and scripts. Render it once in the document head, after your app's scoped stylesheet. Choose your hosting model:</p>
            <NTTabView Id="getting-started-hosting" AriaLabel="Hosting model" UpdateQueryString="false" class="docs-guide-tabs">
                <NTTab Label="Blazor Web App">
                    <p>In <code>Components/App.razor</code>, keep the template's head content and add the dependencies after the scoped stylesheet. Replace <code>YourApp</code> with your assembly name.</p>
                    <DocsCode Title="Components/App.razor" Code="@_webAppHead" />
                    <p>Give <code>Routes</code> and <code>HeadOutlet</code> the same render mode, so every page inherits it. For WebAssembly or Auto, use <code>InteractiveWebAssembly</code> or <code>InteractiveAuto</code> and put browser-rendered pages in the <code>.Client</code> project.</p>
                    <p>The server's <code>Program.cs</code> needs the interactive services and endpoints your template already has. For WebAssembly or Auto, keep the template's <code>AddInteractiveWebAssemblyComponents</code>, <code>AddInteractiveWebAssemblyRenderMode</code>, and <code>AddAdditionalAssemblies</code> calls too. Microsoft's <a href="https://learn.microsoft.com/en-us/aspnet/core/blazor/components/render-modes?view=aspnetcore-10.0">render modes guide</a> covers the details.</p>
                    <DocsCode Title="Program.cs" Code="@_webAppProgram" />
                </NTTab>
                <NTTab Label="Standalone WebAssembly">
                    <p>In <code>Program.cs</code>, register <code>HeadOutlet</code> once so pages can add head content:</p>
                    <DocsCode Title="Program.cs" Code="@_wasmProgram" />
                    <p>In <code>App.razor</code>, put the dependencies in <code>HeadContent</code> above your router:</p>
                    <DocsCode Title="App.razor" Code="@_wasmHead" />
                    <p>Keep the <code>YourApp.styles.css</code> link in <code>wwwroot/index.html</code>. WebAssembly is always interactive, so pages don't need a render mode.</p>
                </NTTab>
            </NTTabView>
            <p>Both pieces matter: <code>YourApp.styles.css</code> brings in each component's styles, and <code>NTHeadDependencies</code> brings in what they share.</p>
        </section>

        <section id="themes" class="docs-section">
            <h2>4. Add a theme</h2>
            <div class="docs-callout docs-callout-important">
                <strong>This step is required</strong>
                <span>NTComponents doesn't ship any colors. Until your app serves the theme files below, components render without their color roles.</span>
            </div>
            <p>Pick your colors in the <a href="/tools/material-theme">theme creator</a> and select <strong>Download generated themes</strong>. Extract the archive's <code>Themes</code> folder into <code>wwwroot</code>:</p>
            <DocsCode Title="wwwroot" Code="@_themeFiles" />
            <p>The six files cover light and dark, each at default, medium, and high contrast. <code>NTHeadDependencies</code> loads the one that matches the user's choice, and System follows the operating system.</p>
            <p>Let users choose by adding a theme toggle to your header. It remembers their choice in local storage. To offer only light, dark, and system, set <code>AllowContrastSelection="false"</code>.</p>
            <DocsCode Title="Razor" Code="&lt;NTThemeToggle /&gt;" />
        </section>

        <section id="layout" class="docs-section">
            <h2>5. Set up the layout</h2>
            <p><code>NTLayout</code> gives you the app shell. Render each service host once, in the same interactive scope as the code that calls its service: <code>NTToast</code> for <code>INTToastService</code>, <code>NTSnackbar</code> for <code>INTSnackbarService</code>, and <code>NTWindowHost</code> for <code>INTWindowService</code>. Leave out the hosts you don't use.</p>
            <DocsCode Title="Layout/MainLayout.razor" Code="@_layout" />
            <p><code>NTDialog</code> doesn't need a host; place it in the page that owns its content. See the <a href="/components/ntdialog">NTDialog</a> and <a href="/components/ntwindowhost">NTWindowHost</a> pages for complete examples.</p>
        </section>

        <section id="first-page" class="docs-section">
            <h2>6. Build your first page</h2>
            <p>Add <code>Welcome.razor</code> to your pages folder:</p>
            <DocsCode Title="Pages/Welcome.razor" Code="@_firstPage" />
            <p>Run <code>dotnet run</code> and open <code>/welcome</code>. Select <strong>Save</strong> and a success toast appears. Switch the theme toggle: the colors change, and your choice survives a reload.</p>
            <p>If your app sets render modes per page instead of globally, add <code>@@rendermode InteractiveServer</code> to this page and keep the <code>NTToast</code> host in an interactive part of the app. Each <a href="/components">component page</a> says whether the component also works in static server rendering.</p>
        </section>

        <section id="configuration" class="docs-section">
            <h2>Customize the setup</h2>
            <h3>Theme location and defaults</h3>
            <p>Themes load from <code>/Themes</code> by default. If your app runs under a base path such as <code>/my-app/</code>, include it, and give the head dependencies and the toggle the same settings. A saved user choice overrides the defaults.</p>
            <DocsCode Title="Razor" Code="@_themeConfiguration" />
            <p>Both components also take <code>LightDefaultCss</code>, <code>LightMediumCss</code>, <code>LightHighCss</code>, <code>DarkDefaultCss</code>, <code>DarkMediumCss</code>, and <code>DarkHighCss</code> if your files use other names.</p>
            <h3>Fonts and measurements</h3>
            <p>Roboto and Material Symbols load from Google Fonts by default. To host fonts yourself, point <code>FontStylesheetHref</code> at a stylesheet that defines them, or set <code>FontFamilies="NTFontFamily.None"</code> to skip font requests. <code>HeaderHeight</code>, <code>FooterHeight</code>, and <code>SideNavWidth</code> are in pixels and default to 64, 64, and 256.</p>
            <DocsCode Title="Razor" Code="@_headConfiguration" />
            <h3>Theme colors in your own styles</h3>
            <p>Use the <code>--nt-color-*</code> tokens so your own content follows the selected theme and contrast:</p>
            <DocsCode Title="CSS" Code="@_tokens" />
        </section>

        <section id="debug-console" class="docs-section">
            <h2>Add a debug console (optional)</h2>
            <p><a href="/components/ntdebugconsole">NTDebugConsole</a> collects the session's logs, your app's messages, and the toasts and snackbars the user saw, in a collapsible bar at the bottom of the page. It helps you reproduce bugs in a deployed app, and it stays off until you decide who can see it.</p>
            <DocsCode Title="Program.cs" Code="@_debugConsole" />
            <p>Then add <code>&lt;NTDebugConsole /&gt;</code> to your layout. Users show and hide it with Ctrl+`. On Blazor Server, each user only ever sees their own circuit's entries.</p>
        </section>

        <section id="charts" class="docs-section">
            <h2>Add charts (optional)</h2>
            <p>The <code>NTComponents.Charts</code> package adds interactive line, area, bar, point, heat map, box plot, pie, radar, tree map, and bubble pack charts. Charts draw to a canvas with SkiaSharp, so they run in the browser through Blazor WebAssembly. Add the package next to <code>NTComponents</code>, and complete steps 1 to 4 first.</p>
            <DocsCode Title="Terminal" Code="dotnet add package NTComponents.Charts" />
            <p>Add the namespaces to <code>_Imports.razor</code>, or to the page that uses a chart:</p>
            <DocsCode Title="_Imports.razor" Code="@_chartImports" />
            <p><code>NTComponents</code> also has a general <code>NTTooltip</code>, so a chart's tooltip needs its full name: <code>&lt;NTComponents.Charts.Core.NTTooltip TData="SalesPoint" /&gt;</code>.</p>
            <h3>Link the native assets</h3>
            <p>SkiaSharp needs its native WebAssembly build in the browser. Install the wasm-tools workload, then turn on native linking in the WebAssembly client project, which is the standalone app or the <code>.Client</code> project of a Blazor Web App:</p>
            <DocsCode Title="Terminal" Code="dotnet workload install wasm-tools" />
            <DocsCode Title="YourApp.Client.csproj" Code="@_chartProject" />
            <div class="docs-callout docs-callout-important">
                <strong>Browser rendering needs .NET 10 for now</strong>
                <span>SkiaSharp 4.153.1 can't link its native assets with the .NET 11 toolchain, so charts build and trim on .NET 11 but don't render in the browser. Target .NET 10 until SkiaSharp ships compatible native assets.</span>
            </div>
            <h3>Build your first chart</h3>
            <p>A chart fills its parent, so give it a height. Each series reads its X and Y values from your data:</p>
            <DocsCode Title="Pages/Sales.razor" Code="@_firstChart" />
            <h3>Theming</h3>
            <p>Charts read the same Material 3 theme as the rest of NTComponents, so the colors follow your theme files, light and dark mode, and contrast. A chart redraws when the user changes the theme. Series take their colors from a palette of theme roles, and any color you set is an <code>NTColor</code> role.</p>
            <h3>Explore the charts</h3>
            <p>Start with <a href="/components/ntchart">NTChart</a> for axes, legends, annotations, and interactions. Then see <a href="/components/ntlineseries">NTLineSeries</a>, <a href="/components/ntareaseries">NTAreaSeries</a>, <a href="/components/ntbarseries">NTBarSeries</a>, <a href="/components/ntpointseries">NTPointSeries</a>, <a href="/components/ntheatmapseries">NTHeatMapSeries</a>, and <a href="/components/ntboxplotseries">NTBoxPlotSeries</a> for cartesian charts, and <a href="/components/ntpieseries">NTPieSeries</a>, <a href="/components/ntradarseries">NTRadarSeries</a>, <a href="/components/nttreemapseries">NTTreeMapSeries</a>, and <a href="/components/ntbubblepackseries">NTBubblePackSeries</a> for circular ones.</p>
        </section>

        <section id="troubleshooting" class="docs-section">
            <h2>Troubleshooting</h2>
            <div class="docs-table-wrap">
                <table class="docs-table">
                    <thead><tr><th>Symptom</th><th>Check</th></tr></thead>
                    <tbody>
                        <tr><td>Components have no colors</td><td>Serve the six theme files from <code>wwwroot/Themes</code>, or from the <code>ThemesRoot</code> you configured. The browser's Network tools show whether each file loads.</td></tr>
                        <tr><td>Components look unstyled</td><td>Load the app's <code>YourApp.styles.css</code> and render <code>NTHeadDependencies</code> once. In a Blazor Web App, keep <code>MapStaticAssets()</code>.</td></tr>
                        <tr><td>Colors don't switch</td><td>Check that all six files exist with matching names and casing, and that the toggle and head dependencies use the same <code>ThemesRoot</code>, including any base path.</td></tr>
                        <tr><td>Clicks do nothing</td><td>Give the page an interactive render mode and keep the template's Blazor script. Static server rendering doesn't run Blazor event callbacks.</td></tr>
                        <tr><td>A toast, snackbar, or window never appears</td><td>Call <code>AddNTServices()</code> and render the matching host once, in the same interactive scope as the code that calls the service.</td></tr>
                        <tr><td>A service is missing while prerendering</td><td>For WebAssembly or Auto, call <code>AddNTServices()</code> in both the server and client projects. Use browser storage and JavaScript interop only after the first interactive render.</td></tr>
                        <tr><td>Icons show words instead of symbols</td><td>The Material Symbols font didn't load. Check the font requests, and with self-hosted fonts, include the Material Symbols families.</td></tr>
                    </tbody>
                </table>
            </div>
            <p>After publishing, check the same asset and theme paths on the deployed app. The <a href="/components">component pages</a> have live examples with copyable Razor.</p>
        </section>
    </main>
</NTContainerView>

@code {
    private const string _newApp = """
        dotnet new blazor -n YourApp -f net10.0 --interactivity Server --all-interactive
        cd YourApp
        dotnet add package NTComponents
        """;

    private const string _imports = """
        @using NTComponents
        @using Microsoft.AspNetCore.Components.Web
        @using static Microsoft.AspNetCore.Components.Web.RenderMode
        """;

    private const string _services = """
        using NTComponents;

        builder.Services.AddNTServices();
        """;

    private const string _webAppHead = """
        <head>
            @* Keep the other head elements from your template. *@
            <link rel="stylesheet" href="@Assets["YourApp.styles.css"]" />
            <NTHeadDependencies />
            <HeadOutlet @rendermode="InteractiveServer" />
        </head>
        <body>
            <Routes @rendermode="InteractiveServer" />
            <script src="@Assets["_framework/blazor.web.js"]"></script>
        </body>
        """;

    private const string _webAppProgram = """
        builder.Services.AddRazorComponents()
            .AddInteractiveServerComponents();
        builder.Services.AddNTServices();

        var app = builder.Build();
        // Keep the template's middleware.
        app.MapStaticAssets();
        app.MapRazorComponents<App>()
            .AddInteractiveServerRenderMode();
        """;

    private const string _wasmProgram = """
        using Microsoft.AspNetCore.Components.Web;

        builder.RootComponents.Add<HeadOutlet>("head::after");
        builder.Services.AddNTServices();
        """;

    private const string _wasmHead = """
        <HeadContent>
            <NTHeadDependencies />
        </HeadContent>
        """;

    private const string _themeFiles = """
        wwwroot/
          Themes/
            light.css
            light-mc.css
            light-hc.css
            dark.css
            dark-mc.css
            dark-hc.css
        """;

    private const string _layout = """
        @inherits LayoutComponentBase

        <NTLayout>
            <NTHeader>
                <NTThemeToggle />
            </NTHeader>
            <NTBody>
                @Body
            </NTBody>
        </NTLayout>

        <NTToast />
        <NTSnackbar />
        <NTWindowHost />
        """;

    private const string _firstPage = """
        @page "/welcome"
        @inject INTToastService ToastService

        <h1>Welcome to NTComponents</h1>
        <NTCard>
            <p>Your component library is ready.</p>
            <NTButton Label="Save" OnClickCallback="SaveAsync" />
        </NTCard>

        @code {
            private Task SaveAsync() => ToastService.ShowSuccessAsync("Saved", "Your setup is working.");
        }
        """;

    private const string _themeConfiguration = """
        @* In the document head: *@
        <NTHeadDependencies ThemesRoot="/my-app/Themes" DefaultTheme="NTTheme.System" DefaultContrast="NTThemeContrast.Default" />

        @* In your header: *@
        <NTThemeToggle ThemesRoot="/my-app/Themes" DefaultTheme="NTTheme.System" DefaultContrast="NTThemeContrast.Default" AllowContrastSelection="false" />
        """;

    private const string _headConfiguration = """
        <NTHeadDependencies FontStylesheetHref="/fonts/fonts.css" HeaderHeight="64" FooterHeight="64" SideNavWidth="256" />
        """;

    private const string _tokens = """
        .order-summary {
            background: var(--nt-color-surface-container);
            color: var(--nt-color-on-surface);
            border: 1px solid var(--nt-color-outline-variant);
        }
        """;

    private const string _chartImports = """
        @using NTComponents.Charts
        @using NTComponents.Charts.Core
        @using NTComponents.Charts.Core.Axes
        @using NTComponents.Charts.Core.Series
        """;

    private const string _chartProject = """
        <PropertyGroup>
            <WasmBuildNative>true</WasmBuildNative>
        </PropertyGroup>
        """;

    private const string _firstChart = """
        @page "/sales"

        <NTChart TData="SalesPoint" style="height: 320px">
            <NTLineSeries Data="_sales" Title="Sales" XValue="@(point => point.Month)" YValueSelector="@(point => point.Total)" />
            <NTComponents.Charts.Core.NTTooltip TData="SalesPoint" />
        </NTChart>

        @code {
            private readonly SalesPoint[] _sales = [new("January", 120m), new("February", 180m), new("March", 150m)];

            private sealed record SalesPoint(string Month, decimal Total);
        }
        """;

    private const string _debugConsole = """
        // Blazor Server (NTComponents.AspNetCore package): only support staff see the console,
        // and each of them sees only their own circuit's entries.
        builder.Services.AddNTDebugConsoleForServer(options =>
            options.Authorize = state => state.User.IsInRole("Support"));

        // WebAssembly: the logs never leave the user's browser.
        builder.Services.AddNTDebugConsole(options => options.AllowAll());
        """;
}

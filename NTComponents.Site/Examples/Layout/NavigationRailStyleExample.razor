<div class="docs-fill" style="display: flex; block-size: 20rem; position: relative; overflow: hidden;">
    <NTNavigationRail AriaLabel="Compact square navigation"
                      HideRailOnXSScreens="false"
                      Compact="true"
                      Variant="NTNavigationRailVariant.Square"
                      IndicatorStyle="ActiveLinkIndicatorStyle.FullWidth"
                      style="block-size: 100%; min-block-size: 0; max-block-size: 100%;">
        <NTNavigationRailItem Label="Files"
                              Href="#files"
                              Icon="MaterialIcon.Description"
                              Selected="true" />
        <NTNavigationRailItem Label="Shared" Href="#shared" Icon="MaterialIcon.Share" />
        <NTNavigationRailItem Label="Recent" Href="#recent" Icon="MaterialIcon.Schedule" />
    </NTNavigationRail>
    <div style="display: grid; align-content: start; gap: 8px; padding: 16px;">
        <h4 class="nt-title-large" style="margin: 0;">Files</h4>
        <p style="margin: 0;">Compact rails fit more destinations in less height.</p>
    </div>
</div>

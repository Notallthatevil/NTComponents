<div class="docs-fill" style="block-size: 24rem; position: relative; overflow: hidden;">
    <NTLayout style="block-size: 100%; min-block-size: 0;">
        <NTNavigationRail AriaLabel="Layout example navigation" HideRailOnXSScreens="false" style="block-size: 100%; min-block-size: 0; max-block-size: 100%;">
            <NTNavigationRailItem Label="Inbox"
                                  Href="#inbox"
                                  Icon="MaterialIcon.Inbox"
                                  Selected="true" />
            <NTNavigationRailItem Label="Sent" Href="#sent" Icon="MaterialIcon.Send" />
            <NTNavigationRailItem Label="Drafts" Href="#drafts" Icon="MaterialIcon.Drafts" />
        </NTNavigationRail>
        <NTHeader FixedPosition="false">
            <h4 class="nt-title-large" style="margin: 0; padding: 16px;">Mail</h4>
        </NTHeader>
        <NTBody>
            <div style="display: grid; gap: 8px; padding: 16px;">
                <p style="margin: 0;">Welcome back. You have 3 unread messages.</p>
            </div>
        </NTBody>
    </NTLayout>
</div>

<div class="docs-fill" style="display: flex; block-size: 26rem; position: relative; overflow: hidden;">
    <NTNavigationRail AriaLabel="Workspace navigation" HideRailOnXSScreens="false" style="block-size: 100%; min-block-size: 0; max-block-size: 100%;">
        <NTNavigationRailItem Label="Dashboard"
                              Href="#dashboard"
                              Icon="MaterialIcon.Dashboard"
                              Selected="true" />
        <NTNavigationRailSectionHeader Label="Workspace" />
        <NTNavigationRailGroup Label="Projects" Icon="MaterialIcon.Folder">
            <NTNavigationRailItem Label="Active" Href="#active" Icon="MaterialIcon.FolderOpen" />
            <NTNavigationRailItem Label="Archived" Href="#archived" Icon="MaterialIcon.Archive" />
        </NTNavigationRailGroup>
        <NTNavigationRailGroup Label="Team" Icon="MaterialIcon.Group">
            <NTNavigationRailItem Label="Members" Href="#members" Icon="MaterialIcon.Person" />
            <NTNavigationRailItem Label="Roles" Href="#roles" Icon="MaterialIcon.AdminPanelSettings" />
        </NTNavigationRailGroup>
    </NTNavigationRail>
    <div style="display: grid; align-content: start; gap: 8px; padding: 16px;">
        <h4 class="nt-title-large" style="margin: 0;">Dashboard</h4>
        <p style="margin: 0;">Click a group to open its destinations.</p>
    </div>
</div>

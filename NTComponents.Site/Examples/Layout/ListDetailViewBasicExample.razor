<div class="docs-fill" style="block-size: 20rem; position: relative; overflow: hidden;">
    <NTListDetailView FullHeight="true" ListPaneLabel="Projects" DetailPaneLabel="Project details">
        <List>
            <ul style="list-style: none; margin: 0; padding: 0;">
                @for (var i = 0; i < _projects.Length; i++) {
                    var index = i;
                    <li>
                        <a href="#project-@index"
                           style="display: grid; gap: 4px; padding: 12px 16px; color: inherit; text-decoration: none;"
                           aria-current="@(index == 0 ? "true" : null)"
                           data-nt-list-detail-trigger="@index"
                           data-nt-list-detail-selected="@(index == 0 ? "true" : "false")">
                            <span class="nt-title-medium">@_projects[index].Title</span>
                            <span class="nt-body-medium">@_projects[index].Owner</span>
                        </a>
                    </li>
                }
            </ul>
        </List>
        <Detail>
            @for (var i = 0; i < _projects.Length; i++) {
                var index = i;
                <div style="display: grid; gap: 8px; padding: 16px;" data-nt-list-detail-panel="@index" hidden="@(index != 0)">
                    <h4 class="nt-title-large" style="margin: 0;">@_projects[index].Title</h4>
                    <p style="margin: 0;">@_projects[index].Description</p>
                    <p style="margin: 0;">Owner: @_projects[index].Owner</p>
                </div>
            }
        </Detail>
    </NTListDetailView>
</div>

@code {
    private sealed record Project(string Title, string Owner, string Description);

    private readonly Project[] _projects = [
        new("Migration plan", "Priya Shah", "Move the billing database to the new cluster before quarter end."),
        new("Design refresh", "Marcus Lee", "Update the marketing site with the new type scale and color palette."),
        new("Security audit", "Elena Rossi", "Review access policies and rotate stale credentials."),
        new("Mobile launch", "Tom Becker", "Ship the first public release of the iOS and Android apps.")
    ];
}

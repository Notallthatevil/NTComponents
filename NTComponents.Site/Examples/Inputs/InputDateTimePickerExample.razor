<NTFormFieldGridView class="docs-fill" MaxColumns="2">
    <NTInputDateTime DateTimeType="DateOnly?" Label="Check-in" EnableCustomPicker="true" @bind-Value="_checkIn" />
    <NTInputDateTime DateTimeType="DateTime?" Label="Meeting" EnableCustomPicker="true" @bind-Value="_meeting" />
</NTFormFieldGridView>
<p>Check-in: <output>@_checkIn</output></p>

@code {
    private DateOnly? _checkIn = new DateOnly(2026, 12, 20);
    private DateTime? _meeting = new DateTime(2026, 12, 21, 9, 0, 0);
}

<NTFormFieldGridView class="docs-fill" MaxColumns="1">
    <NTInputColor Label="Overlay color"
                  ShowAlpha="true"
                  SupportingText="Opacity below 100% is saved as #rrggbbaa."
                  @bind-Value="_color" />
</NTFormFieldGridView>
<p>Selected: <output>@_color</output></p>

@code {
    private string? _color = "#6750a480";
}

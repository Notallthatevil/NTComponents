<NTForm Model="_model" OnValidSubmit="Submit" class="docs-fill">
    <DataAnnotationsValidator />
    <NTFormSectionView MaxColumns="1">
        <NTInputDateTime DateTimeType="DateTime?" Label="Delivery time" SupportingText="Required." @bind-Value="_model.DeliveryTime" />
        <div class="docs-row">
            <NTButton Type="ButtonType.Submit" Label="Schedule delivery" />
        </div>
    </NTFormSectionView>
</NTForm>
<p>Status: <output>@_status</output></p>

@code {
    private readonly Delivery _model = new();
    private string _status = "Waiting";

    private void Submit() => _status = $"Scheduled for {_model.DeliveryTime}";

    private sealed class Delivery {
        [System.ComponentModel.DataAnnotations.Required]
        public DateTime? DeliveryTime { get; set; }
    }
}

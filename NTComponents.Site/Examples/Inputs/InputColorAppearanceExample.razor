<NTFormFieldGridView class="docs-fill" MaxColumns="2">
    <NTInputColor Label="Filled"
                  Appearance="NTFormAppearance.Filled"
                  LeadingIcon="MaterialIcon.Palette"
                  @bind-Value="_filled" />
    <NTInputColor Label="Outlined" Appearance="NTFormAppearance.Outlined" @bind-Value="_outlined" />
    <NTInputColor Label="With opacity" ShowAlpha="true" @bind-Value="_translucent" />
    <NTInputColor Label="Locked" Disabled="true" @bind-Value="_locked" />
</NTFormFieldGridView>

@code {
    private string? _filled = "#0b6e4f";
    private string? _outlined = "#c2410c";
    private string? _translucent = "#6750a480";
    private string? _locked = "#1d4ed8";
}

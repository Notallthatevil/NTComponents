<NTFormFieldGridView class="docs-fill" MaxColumns="1">
    <NTTextArea Label="Product description"
                SupportingText="Shown on the product page."
                ShowCharacterCounter="true"
                maxlength="200"
                Appearance="NTFormAppearance.Filled"
                @bind-Value="_description" />
</NTFormFieldGridView>

@code {
    private string? _description = "Insulated stainless steel bottle that keeps drinks cold for 24 hours.";
}

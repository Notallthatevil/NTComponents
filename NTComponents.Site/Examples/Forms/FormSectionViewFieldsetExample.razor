<NTForm Model="_prefs" class="docs-fill">
    <NTFormSectionView Heading="Notification preferences"
                       Description="Choose where we reach you."
                       UseFieldset="true"
                       MaxColumns="2">
        <NTInputText Label="Notification email" InputType="TextInputType.Email" @bind-Value="_prefs.Email" />
        <NTInputText Label="Digest frequency" @bind-Value="_prefs.Frequency" />
    </NTFormSectionView>
</NTForm>

@code {
    private readonly PrefsModel _prefs = new();

    private sealed class PrefsModel {
        public string Email { get; set; } = "alerts@example.com";
        public string Frequency { get; set; } = "Weekly";
    }
}

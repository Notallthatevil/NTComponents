<NTSplitButton Label="Reply" LeadingIcon="MaterialIcon.Reply" Variant="NTButtonVariant.Tonal" @bind-Expanded="_expanded">
    <NTMenuButtonItem Label="Reply all" OnClickCallback="@(() => _choice = "Reply all")" />
    <NTMenuButtonItem Label="Forward" OnClickCallback="@(() => _choice = "Forward")" />
    <NTMenuAnchorItem Label="Open in inbox" Href="/components" />
</NTSplitButton>
<p>Menu is <output>@(_expanded ? "open" : "closed")</output>, last choice: <output>@_choice</output></p>

@code {
    private bool _expanded;
    private string _choice = "none";
}

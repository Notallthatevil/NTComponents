<div class="docs-row">
    <NTButton Label="Favorite"
              LeadingIcon="MaterialIcon.Favorite"
              IsToggleButton="true"
              @bind-Selected="_favorite" />
    <NTButton Label="Notifications"
              Variant="NTButtonVariant.Outlined"
              IsToggleButton="true"
              @bind-Selected="_notifications" />
</div>
<p>Favorite: <output>@(_favorite ? "on" : "off")</output>, notifications: <output>@(_notifications ? "on" : "off")</output></p>

@code {
    private bool _favorite;
    private bool _notifications = true;
}

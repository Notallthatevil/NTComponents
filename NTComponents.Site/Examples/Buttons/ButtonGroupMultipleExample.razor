<NTButtonGroup TObjectType="string" AriaLabel="Text formatting" SelectionMode="NTButtonGroupSelectionMode.Multiple" @bind-SelectedKeys="_formats">
    <NTButtonGroupItem Key="@("bold")" AriaLabel="Bold" Icon="MaterialIcon.FormatBold" />
    <NTButtonGroupItem Key="@("italic")" AriaLabel="Italic" Icon="MaterialIcon.FormatItalic" />
    <NTButtonGroupItem Key="@("underline")" AriaLabel="Underline" Icon="MaterialIcon.FormatUnderlined" />
</NTButtonGroup>
<p>Active formats: <output>@(_formats.Count == 0 ? "none" : string.Join(", ", _formats))</output></p>

@code {
    private IReadOnlyCollection<string> _formats = ["bold"];
}

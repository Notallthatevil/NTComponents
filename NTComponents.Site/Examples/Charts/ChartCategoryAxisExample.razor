@using NTComponents.Charts
@using NTComponents.Charts.Core
@using NTComponents.Charts.Core.Axes

<NTChart TData="Sale" style="height: 320px">
    <NTXAxisOptions TData="Sale" TAxisType="string" ValueSelector="@(sale => sale.Month)" Title="Month" />
    <NTYAxisOptions TData="Sale" TAxisValue="decimal" ValueSelector="@(sale => sale.Units)" Title="Units sold" LabelFormat="{0:0} u" />
    <NTBarSeries Data="_sales" XValue="@(sale => sale.Month)" YValueSelector="@(sale => sale.Units)" />
    <NTComponents.Charts.Core.NTTooltip TData="Sale" />
</NTChart>

@code {
    private readonly Sale[] _sales = [
        new("Jan", 120), new("Feb", 150), new("Mar", 170), new("Apr", 160), new("May", 210), new("Jun", 240)
    ];

    private sealed record Sale(string Month, decimal Units);
}

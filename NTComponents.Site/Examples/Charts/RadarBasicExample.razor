@using NTComponents.Charts
@using NTComponents.Charts.Core
@using NTComponents.Charts.Core.Axes

<div class="docs-fill" style="height: 400px">
    <NTChart TData="Skill">
        <NTRadialAxisOptions TData="Skill" />
        <NTRadarSeries TData="Skill"
                       Data="_skills"
                       XValue="@(s => s.Name)"
                       ValueSelector="@(s => s.Score)"
                       MaxValue="10m"
                       Title="Candidate" />
    </NTChart>
</div>

@code {
    private readonly Skill[] _skills = [new("Design", 7m), new("Backend", 9m), new("Frontend", 6m), new("Testing", 8m), new("Communication", 5m), new("Operations", 7m)];

    private sealed record Skill(string Name, decimal Score);
}

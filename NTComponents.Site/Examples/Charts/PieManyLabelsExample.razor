@using NTComponents.Charts
@using NTComponents.Charts.Core

<div class="docs-actions">
    @foreach (var position in Enum.GetValues<LegendPosition>()) {
        <NTButton Label="@position.ToString()" Variant="@(position == _position ? NTButtonVariant.Filled : NTButtonVariant.Outlined)" OnClickCallback="@(() => _position = position)" />
    }
</div>

<div class="docs-fill" style="height: 420px">
    <NTChart TData="Claim" TitleOptions="@(new NTTitleOptions("Claim count by body part"))">
        <NTLegend TData="Claim" Position="_position" MaxRows="3" />
        <NTTooltip TData="Claim" />
        <NTPieSeries TData="Claim"
                     Data="_claims"
                     XValue="@(claim => claim.BodyPart)"
                     ValueSelector="@(claim => claim.Count)" />
    </NTChart>
</div>


@using NTComponents.Charts
@using NTComponents.Charts.Core

<div class="docs-actions">
    @foreach (var position in _positions) {
        <NTButton Label="@position.ToString()" Variant="@(position == _position ? NTButtonVariant.Filled : NTButtonVariant.Outlined)" OnClickCallback="@(() => _position = position)" />
    }
</div>

<NTChart TData="Sale" style="height: 320px">
    <NTLineSeries Data="_sales"
                  Title="Online"
                  XValue="@(sale => sale.Month)"
                  YValueSelector="@(sale => sale.Online)" />
    <NTLineSeries Data="_sales"
                  Title="In store"
                  XValue="@(sale => sale.Month)"
                  YValueSelector="@(sale => sale.InStore)" />
    <NTLegend TData="Sale" Position="_position" />
</NTChart>

@code {
    private static readonly LegendPosition[] _positions = [LegendPosition.Top, LegendPosition.Bottom, LegendPosition.Left, LegendPosition.Right, LegendPosition.Floating];
    private LegendPosition _position = LegendPosition.Right;

    private readonly Sale[] _sales = [
        new("Jan", 120, 90), new("Feb", 150, 85), new("Mar", 170, 110),
        new("Apr", 160, 130), new("May", 210, 125), new("Jun", 240, 140)
    ];

    private sealed record Sale(string Month, decimal Online, decimal InStore);
}

@using NTComponents.Charts
@using NTComponents.Charts.Core

<NTChart TData="Sale" style="height: 320px">
    <NTBarSeries Data="_sales" ShowDataLabels="true" DataLabelFormat="{0:0}" XValue="@(sale => sale.Month)" YValueSelector="@(sale => sale.Total)" />
</NTChart>

@code {
    private readonly Sale[] _sales = [new("Jan", 120), new("Feb", 150), new("Mar", 170), new("Apr", 160), new("May", 210), new("Jun", 240)];

    private sealed record Sale(string Month, decimal Total);
}

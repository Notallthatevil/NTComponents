<NTButton Label="Delete project" OnClickCallback="OpenAsync" />
<p>Status: <output>@_status</output></p>

<NTDialog @ref="_dialog"
          Id="dialog-destructive-example"
          Title="Delete Q3 roadmap?"
          SupportingText="The project and its 23 tasks will be permanently removed."
          ButtonSpacing="NTDialogButtonSpacing.SpaceBetween"
          OnClosed="HandleClosed">
    <Buttons>
        <button type="button" class="nt-dialog-button" command="request-close" commandfor="dialog-destructive-example" value="archive">Archive instead</button>
        <span style="display: flex; gap: 8px;">
            <button type="button" class="nt-dialog-button" command="request-close" commandfor="dialog-destructive-example" value="cancel">Cancel</button>
            <button type="button" class="nt-dialog-button" command="request-close" commandfor="dialog-destructive-example" value="delete">Delete</button>
        </span>
    </Buttons>
</NTDialog>

@code {
    private NTDialog? _dialog;
    private string _status = "Project is active";

    private async Task OpenAsync() {
        if (_dialog is not null) {
            await _dialog.OpenAsync();
        }
    }

    private void HandleClosed(NTDialogEventArgs args) => _status = args.ReturnValue switch {
        "delete" => "Project deleted",
        "archive" => "Project archived",
        _ => "Project is active"
    };
}

<NTSelect TValue="string"
          @bind-Value="_filledTeam"
          Label="Filled"
          Appearance="NTFormAppearance.Filled">
    <option value="engineering">Engineering</option>
    <option value="design">Design</option>
</NTSelect>
<NTSelect TValue="string"
          @bind-Value="_outlinedTeam"
          Label="Outlined"
          Appearance="NTFormAppearance.Outlined">
    <option value="engineering">Engineering</option>
    <option value="design">Design</option>
</NTSelect>
<NTSelect TValue="string"
          @bind-Value="_comfortableTeam"
          Label="Comfortable outlined"
          Appearance="NTFormAppearance.Outlined"
          Density="NTFormDensity.Comfortable">
    <option value="engineering">Engineering</option>
    <option value="design">Design</option>
</NTSelect>

@code {
    private string? _filledTeam = "engineering";
    private string? _outlinedTeam = "engineering";
    private string? _comfortableTeam = "engineering";
}

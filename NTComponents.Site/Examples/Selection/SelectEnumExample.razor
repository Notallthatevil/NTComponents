<NTSelect TValue="Priority"
          @bind-Value="_priority"
          Label="Priority"
          LeadingIcon="MaterialIcon.Label"
          SupportingText="TValue can be an enum or any value type.">
    @foreach (var priority in Enum.GetValues<Priority>()) {
        <option value="@priority">@priority</option>
    }
</NTSelect>
<p>Priority: <output>@_priority</output></p>

@code {
    private Priority _priority = Priority.Medium;

    private enum Priority {
        Low,
        Medium,
        High,
        Urgent
    }
}

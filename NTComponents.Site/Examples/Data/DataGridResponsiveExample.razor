<NTDataGrid TItem="Order"
            Items="_orders"
            Caption="Orders by region"
            RowKey="order => order.Id"
            ShowPagination="true"
            PageSize="5"
            PageSizeOptions="_pageSizes"
            QueryParameterPrefix="docs-responsive"
            class="docs-fill">
    <ChildContent>
        <NTPropertyColumn TItem="Order"
                          TValue="int"
                          Title="Order"
                          Property="order => order.Id"
                          InitialSortDirection="SortDirection.Ascending" />
        <NTPropertyColumn TItem="Order"
                          TValue="string"
                          Title="Customer"
                          Property="order => order.Customer" />
        <NTPropertyColumn TItem="Order"
                          TValue="string"
                          Title="Region"
                          Property="order => order.Region"
                          HideBelow="NTBreakpoint.Medium" />
        <NTPropertyColumn TItem="Order"
                          TValue="DateOnly"
                          Title="Placed"
                          Property="order => order.Placed"
                          Format="d"
                          HideBelow="NTBreakpoint.Small" />
        <NTPropertyColumn TItem="Order"
                          TValue="decimal"
                          Title="Total"
                          Property="order => order.Total"
                          Format="C"
                          TextAlign="TextAlign.Right" />
    </ChildContent>
    <RowDetailTemplate Context="order">
        <dl class="docs-row">
            <dt>Region</dt>
            <dd>@order.Region</dd>
            <dt>Placed</dt>
            <dd>@order.Placed.ToString("d")</dd>
        </dl>
    </RowDetailTemplate>
</NTDataGrid>

@code {
    private static readonly IReadOnlyList<int> _pageSizes = [5, 10, 20];
    private static readonly string[] _regions = ["North", "South", "East", "West"];

    private readonly IQueryable<Order> _orders = Enumerable.Range(1, 42)
        .Select(index => new Order(1000 + index, $"Customer {index:00}", _regions[index % _regions.Length], new DateOnly(2026, 1, 1).AddDays(index), index * 12.5m))
        .AsQueryable();

    private sealed record Order(int Id, string Customer, string Region, DateOnly Placed, decimal Total);
}

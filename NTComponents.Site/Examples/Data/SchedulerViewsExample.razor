@using NTComponents.Scheduler

<p>Showing <output>@_view</output> for <output>@_date.ToString("MMM d, yyyy")</output></p>
<NTScheduler TEventType="TnTEvent"
             Events="_events"
             @bind-View="_view"
             @bind-Date="_date"
             ShowDescription="true"
             AriaLabel="Clinic appointments"
             class="docs-fill"
             style="block-size: 36rem;" />

@code {
    private NTSchedulerView _view = NTSchedulerView.Month;
    private DateTimeOffset _date = DateTimeOffset.Now;
    private readonly List<TnTEvent> _events = CreateEvents();

    private static List<TnTEvent> CreateEvents() {
        var today = DateTime.Today;
        DateTimeOffset At(int day, int hour, int minute = 0) => new(today.AddDays(day).AddHours(hour).AddMinutes(minute));
        return [
            new TnTEvent { Title = "Dental cleaning", Description = "Dr. Hopper, room 2", EventStart = At(0, 10), EventEnd = At(0, 11) },
            new TnTEvent { Title = "Annual checkup", Description = "Bring insurance card", EventStart = At(2, 14), EventEnd = At(2, 15) },
            new TnTEvent { Title = "Physical therapy", Description = "Knee rehab session", EventStart = At(5, 9), EventEnd = At(5, 10) },
            new TnTEvent { Title = "Follow-up call", Description = "Lab results", EventStart = At(9, 16), EventEnd = At(9, 16, 30) }
        ];
    }
}

<NTDataGrid TItem="Order"
            Items="_orders"
            Caption="All orders"
            ShowPagination="true"
            PageSize="5"
            PageSizeOptions="_pageSizes"
            QueryParameterPrefix="docs-orders"
            class="docs-fill">
    <NTPropertyColumn TItem="Order"
                      TValue="int"
                      Title="Order"
                      Property="order => order.Id"
                      InitialSortDirection="SortDirection.Ascending" />
    <NTPropertyColumn TItem="Order"
                      TValue="string"
                      Title="Customer"
                      Property="order => order.Customer" />
    <NTPropertyColumn TItem="Order"
                      TValue="decimal"
                      Title="Total"
                      Property="order => order.Total"
                      Format="C" />
</NTDataGrid>

@code {
    private static readonly IReadOnlyList<int> _pageSizes = [5, 10, 20];

    private readonly IQueryable<Order> _orders = Enumerable.Range(1, 42)
        .Select(index => new Order(1000 + index, $"Customer {index:00}", index * 12.5m))
        .AsQueryable();

    private sealed record Order(int Id, string Customer, decimal Total);
}

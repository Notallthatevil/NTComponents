@namespace NTComponents.Site.Components
@using NTComponents
@using NTComponents.GeneratedDocumentation

<NTTag Label="@Label" BackgroundColor="@BackgroundColor" TextColor="@TextColor" Elevation="0" />

@code {
    [Parameter, EditorRequired]
    public TypeDocumentation Type { get; set; } = default!;

    private string Label => Type.RenderCompatibility switch {
        "SsrCompatible" => "SSR compatible",
        "ProgressivelyEnhanced" => "Progressive SSR",
        "InteractiveRequired" => "Interactive required",
        _ => "SSR unknown"
    };

    private NTColor BackgroundColor => Type.RenderCompatibility switch {
        "SsrCompatible" => NTColor.SuccessContainer,
        "ProgressivelyEnhanced" => NTColor.SecondaryContainer,
        "InteractiveRequired" => NTColor.ErrorContainer,
        _ => NTColor.SurfaceContainerHighest
    };

    private NTColor TextColor => Type.RenderCompatibility switch {
        "SsrCompatible" => NTColor.OnSuccessContainer,
        "ProgressivelyEnhanced" => NTColor.OnSecondaryContainer,
        "InteractiveRequired" => NTColor.OnErrorContainer,
        _ => NTColor.OnSurfaceVariant
    };
}

@namespace NTComponents
@typeparam TItem where TItem : class
@using NTComponents.Virtualization

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
    @ColumnBoundary
</CascadingValue>

<div @attributes="_rootAttributes" class="@RootClass" style="@_style">
    @if (RowDetailTemplate is not null && ShowExpandAllButton) {
        <div class="nt-data-grid-expansion-toolbar">
            <NTButton Label="@(AllRowsExpanded ? "Collapse all" : "Expand all")" Variant="NTButtonVariant.Text"
                      Disabled="@(!RendererInfo.IsInteractive)" OnClickCallback="@(() => SetAllRowsExpandedAsync(!AllRowsExpanded))" />
        </div>
    }
    <div class="nt-data-grid-scroll" style="@ScrollStyle" data-nt-drag-scroll="@DragToScroll">
        <table class="nt-data-grid-table" aria-rowcount="@AccessibleRowCount">
            @if (!string.IsNullOrWhiteSpace(Caption)) {
                <caption>@Caption</caption>
            }
            @if (_columns.Count > 0) {
                <colgroup>
                    @if (RowDetailTemplate is not null) {
                        <col class="nt-data-grid-expansion-column" />
                    }
                    @foreach (var column in _columns) {
                        <col class="@column.ColumnClass" style="@column.ColumnStyle" />
                    }
                </colgroup>
            }
            <thead>
                <tr aria-rowindex="1">
                    @if (RowDetailTemplate is not null) {
                        <th scope="col" class="nt-data-grid-header-cell"><span class="nt-data-grid-header-label">Details</span></th>
                    }
                    @foreach (var column in _columns) {
                        var canSort = CanSort(column);
                        var sortIndex = -1;
                        if (canSort) {
                            var sortPropertyName = column.SortPropertyName;
                            for (var i = 0; i < _sorts.Count; i++) {
                                if (string.Equals(_sorts[i].PropertyName, sortPropertyName, StringComparison.Ordinal)) {
                                    sortIndex = i;
                                    break;
                                }
                            }
                        }

                        SortDirection? sortDirection = sortIndex >= 0 ? _sorts[sortIndex].Direction : null;
                        var showSortOrder = sortIndex >= 0 && _sorts.Count > 1;
                        var sortOrder = sortIndex + 1;
                        var sortLinkClass = sortIndex < 0
                            ? "nt-data-grid-sort-link"
                            : showSortOrder
                                ? "nt-data-grid-sort-link nt-data-grid-sort-link-sorted nt-data-grid-sort-link-multi-sorted"
                                : "nt-data-grid-sort-link nt-data-grid-sort-link-sorted";
                        var ariaSort = sortDirection switch {
                            SortDirection.Ascending => "ascending",
                            SortDirection.Descending => "descending",
                            _ => null
                        };
                        <th scope="col" class="@column.HeaderCellClass" aria-sort="@ariaSort">
                            @if (canSort) {
                                @if (RendererInfo.IsInteractive) {
                                    <button type="button" class="@sortLinkClass" @onclick="() => SortByColumnAsync(column)">
                                        <span class="nt-data-grid-header-title">@column.HeaderTitle</span>
                                        @if (sortDirection is not null) {
                                            <span class="nt-data-grid-sort-state">
                                                @if (showSortOrder) {
                                                    <span class="nt-data-grid-sort-order" aria-label="@($"Sort priority {sortOrder}")">@sortOrder</span>
                                                }
                                                <MaterialIcon class="@GetSortIndicatorClass(sortDirection.Value)" Icon="@GetSortIndicator()" Size="IconSize.Small" aria-hidden="true" />
                                            </span>
                                        }
                                    </button>
                                }
                                else {
                                    <a class="@sortLinkClass" href="@BuildSortHref(column)">
                                        <span class="nt-data-grid-header-title">@column.HeaderTitle</span>
                                        @if (sortDirection is not null) {
                                            <span class="nt-data-grid-sort-state">
                                                @if (showSortOrder) {
                                                    <span class="nt-data-grid-sort-order" aria-label="@($"Sort priority {sortOrder}")">@sortOrder</span>
                                                }
                                                <MaterialIcon class="@GetSortIndicatorClass(sortDirection.Value)" Icon="@GetSortIndicator()" Size="IconSize.Small" aria-hidden="true" />
                                            </span>
                                        }
                                    </a>
                                }
                            }
                            else {
                                <span class="nt-data-grid-header-label">@column.HeaderTitle</span>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Virtualize) {
                    <NTVirtualize @key="_virtualizeVersion" @ref="_virtualizer"
                                  TItem="TItem"
                                  ItemsProvider="ProvideVirtualizedItemsAsync"
                                  ItemSize="ResolvedVirtualizationItemSize"
                                  OverscanCount="VirtualizationOverscanCount"
                                  PlaceholderPreloadWindowCount="@(RowDetailTemplate is null ? VirtualizationPlaceholderPreloadWindowCount : 0)"
                                  MeasureItemSize="@MeasureVirtualizedRows"
                                  InitialItemIndex="InitialItemIndex"
                                  AnchorMode="AnchorMode"
                                  ItemComparer="ItemComparer"
                                  ItemKey="@(_hasRowKeyParameter ? RowKey : null)"
                                  ItemSizeVersion="_expansionVersion"
                                  BackgroundPreloadWindowCount="VirtualizationBackgroundPreloadWindowCount"
                                  RevalidateCachedItems="VirtualizationRevalidateCachedItems"
                                  MaxCachedItemCount="VirtualizationMaxCachedItemCount"
                                  ScrollRestorationKey="@VirtualizedScrollRestorationKey"
                                  SpacerElement="tr"
                                  SpacerTemplate="RenderSpacerCell"
                                  ItemTemplate="RenderRowFragment"
                                  LoadingTemplate="RenderLoadingRow">
                        <EmptyTemplate>
                            @RenderEmptyRow()
                        </EmptyTemplate>
                    </NTVirtualize>
                }
                else if (_loadedItems.Count > 0) {
                    @foreach (var item in _loadedItems) {
                        RenderRow(__builder, item);
                    }
                }
                else {
                    @RenderEmptyRow()
                }
            </tbody>
        </table>
    </div>

    @if (ShowPagination) {
        <nav class="nt-data-grid-pagination" aria-label="@PaginationAriaLabel">
            @if (RendererInfo.IsInteractive || !PersistPageSizeInQuery) {
                <label class="nt-data-grid-page-size">
                    <span>Rows per page</span>
                    <select value="@CurrentPageSize" disabled="@(!RendererInfo.IsInteractive)" @onchange="ChangePageSizeAsync">
                        @foreach (var pageSizeOption in GetResolvedPageSizeOptions()) {
                            <option value="@pageSizeOption">@pageSizeOption</option>
                        }
                    </select>
                </label>
            }
            else {
                <div class="nt-data-grid-page-size" role="group" aria-label="Rows per page">
                    <span>Rows per page</span>
                    @foreach (var pageSizeOption in GetResolvedPageSizeOptions()) {
                        <a href="@BuildHref(0, _sorts, pageSizeOption)" aria-current="@(pageSizeOption == CurrentPageSize ? "true" : null)">@pageSizeOption</a>
                    }
                </div>
            }
            <div class="nt-data-grid-pagination-buttons">
                <a class="@GetPaginationButtonClass(!CanGoToPreviousPage, false, "pagination-first-page")"
                   href="@BuildPageHref(0)"
                   title="First page"
                   aria-label="First page"
                   aria-disabled="@(CanGoToPreviousPage ? "false" : "true")"
                   @onclick="() => GoToPageAsync(0)"
                   @onclick:preventDefault="true">
                    <MaterialIcon Icon="@MaterialIcon.FirstPage" Size="IconSize.Small" />
                </a>
                <a class="@GetPaginationButtonClass(!CanGoToPreviousPage, false, "pagination-previous-page")"
                   href="@BuildPageHref(CurrentPageIndex - 1)"
                   title="Previous page"
                   aria-label="Previous page"
                   aria-disabled="@(CanGoToPreviousPage ? "false" : "true")"
                   @onclick="() => GoToPageAsync(CurrentPageIndex - 1)"
                   @onclick:preventDefault="true">
                    <MaterialIcon Icon="@MaterialIcon.ChevronLeft" Size="IconSize.Small" />
                </a>

                @if (_totalItemCount > 0) {
                    @foreach (var pageIndex in GetVisiblePageIndices()) {
                        var isCurrentPage = CurrentPageIndex == pageIndex;
                        var pageLabel = $"Page {pageIndex + 1}";
                        <a class="@GetPaginationButtonClass(false, isCurrentPage)"
                           href="@BuildPageHref(pageIndex)"
                           title="@pageLabel"
                           aria-label="@pageLabel"
                           aria-current="@(isCurrentPage ? "page" : null)"
                           aria-disabled="@(isCurrentPage ? "true" : "false")"
                           @onclick="() => GoToPageAsync(pageIndex)"
                           @onclick:preventDefault="true">@(pageIndex + 1)</a>
                    }
                    <span class="nt-data-grid-page-jump">
                        <span>Page</span>
                        @if (PageCount <= _maxPageJumpOptions) {
                            <select aria-label="Go to page" value="@(CurrentPageIndex + 1)" onchange="@PageJumpOnChange"
                                    data-nt-data-grid-page-href="@(RendererInfo.IsInteractive ? null : BuildHref(_pageHrefPlaceholder, _sorts))">
                                @for (var pageNumber = 1; pageNumber <= PageCount; pageNumber++) {
                                    <option value="@pageNumber">@pageNumber</option>
                                }
                            </select>
                        }
                        else {
                            <span>@(CurrentPageIndex + 1)</span>
                        }
                        <span>of @PageCount</span>
                    </span>
                }

                <a class="@GetPaginationButtonClass(!CanGoToNextPage, false, "pagination-next-page")"
                   href="@BuildPageHref(CurrentPageIndex + 1)"
                   title="Next page"
                   aria-label="Next page"
                   aria-disabled="@(CanGoToNextPage ? "false" : "true")"
                   @onclick="() => GoToPageAsync(CurrentPageIndex + 1)"
                   @onclick:preventDefault="true">
                    <MaterialIcon Icon="@MaterialIcon.ChevronRight" Size="IconSize.Small" />
                </a>
                <a class="@GetPaginationButtonClass(!CanGoToNextPage, false, "pagination-last-page")"
                   href="@BuildPageHref(PageCount - 1)"
                   title="Last page"
                   aria-label="Last page"
                   aria-disabled="@(CanGoToNextPage ? "false" : "true")"
                   @onclick="() => GoToPageAsync(PageCount - 1)"
                   @onclick:preventDefault="true">
                    <MaterialIcon Icon="@MaterialIcon.LastPage" Size="IconSize.Small" />
                </a>
            </div>
        </nav>
    }
</div>

@code {
    // Kept as Razor templates (not builder code) so the rendered elements get this component's CSS-isolation scope attribute.
    private RenderFragment RenderExpansionCell(TItem item, bool expanded) => @<td class="nt-data-grid-cell nt-data-grid-expansion-cell" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
        <NTButton Label="@(expanded ? CollapseRowText : ExpandRowText)" Variant="NTButtonVariant.Text"
                  Disabled="@(!RendererInfo.IsInteractive)" aria-expanded="@(expanded ? "true" : "false")"
                  OnClickCallback="@(() => ToggleRowExpandedAsync(item))" />
    </td>;

    private RenderFragment RenderRowDetail(TItem item, object identity, int? virtualizeIndex) => @<tr @key="identity" class="nt-data-grid-detail-row" data-nt-virtualize-index="@virtualizeIndex">
        <td colspan="@VisibleColumnCount">
            <div class="nt-data-grid-detail-scroll" style="@_detailStyle" role="region" aria-label="Row details" tabindex="0">
                @RowDetailTemplate!(item)
            </div>
        </td>
    </tr>;
}

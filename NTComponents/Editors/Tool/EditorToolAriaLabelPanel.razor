@namespace NTComponents
@using Microsoft.AspNetCore.Components

<div class="tnt-rich-text-editor-inline-tool"
     data-tool-command="ariaLabel"
     role="dialog"
     aria-label="Accessible label settings"
     hidden
     aria-hidden="true">
    <div class="tnt-rich-text-editor-inline-tool-fields">
        <NTInputText Label="Accessible label"
                     @bind-Value="_label"
                     Appearance="NTFormAppearance.Outlined"
                     Density="NTFormDensity.Standard"
                     Placeholder="Describe the selected text"
                     Disabled="@Disabled"
                     SubmitValue="false"
                     data-role="aria-label-value" />
    </div>
    <div class="tnt-rich-text-editor-inline-tool-actions">
        <NTButton Label="Apply label" ButtonSize="Size.Small" Disabled="@Disabled" Type="ButtonType.Button" data-role="aria-label-apply" />
        <NTButton Label="Cancel" ButtonSize="Size.Small" Disabled="@Disabled" Type="ButtonType.Button" Variant="NTButtonVariant.Text" data-role="aria-label-cancel" />
    </div>
</div>

@code {
    private string? _label;

    [Parameter]
    public bool Disabled { get; set; }
}

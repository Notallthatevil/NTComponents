<Project Sdk="Microsoft.NET.Sdk.Razor">
	<Import Project="..\PackageMetadata.props" />
	<PropertyGroup>
		<TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Title>NTComponents</Title>
		<PackageTags>Blazor;Web;UI;Components;Material;MaterialDesign;WebAssembly;BlazorComponents;.NET9;.NET10;.NET11</PackageTags>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<WarningLevel>8</WarningLevel>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
		<!-- Keep new .NET 11 RC Blazor diagnostics visible while existing call sites are reviewed. -->
		<WarningsNotAsErrors Condition="'$(TargetFramework)' == 'net11.0'">$(WarningsNotAsErrors);BL0012;BL0016</WarningsNotAsErrors>
		<NoWarn>$(NoWarn);CS0618</NoWarn>
		<PackageId>NTComponents</PackageId>
		<Description>Collection of Material-design inspired Blazor UI components for Web and WebAssembly projects. Designed for .NET 9, .NET 10, and .NET 11.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<IsAotCompatible>true</IsAotCompatible>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>
	<ItemGroup>
	  <Content Remove="compilerconfig.json" />
	  <Content Remove="wwwroot\**\*.ts" />
	  <None Update="**\*.ts" Pack="false" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>NTComponents.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NTComponents.CodeDocumentation.Generator\NTComponents.CodeDocumentation.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\NTComponents.Analyzers\NTComponents.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\Submodules\NT.BlazorAnalyzer\NT.BlazorAnalyzer\NT.BlazorAnalyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AspNetCore.SassCompiler" Version="1.103.1" PrivateAssets="all" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.13" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.1.26425.128" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\NTComponents.Analyzers\bin\$(Configuration)\netstandard2.0\NTComponents.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="compilerconfig.json" />
		<None Include="ThirdPartyLicenses\css-anchor-positioning-LICENSE.txt" Pack="true" PackagePath="ThirdPartyLicenses\" />
	</ItemGroup>

	<Target Name="DeleteCssFiles" BeforeTargets="BeforeClean">
		<ItemGroup>
			<CssFiles Include=".\**\*.css" />
		</ItemGroup>

		<Delete Files="@(CssFiles)" />
	</Target>
</Project>

@namespace NTComponents
@using NTComponents.Core
@inherits NTPageScriptComponent<NTAnimation>

@switch (Tag) {
    case NTAnimationTag.Section:
        <section @attributes="WrapperAttributes" @ref="Element">@ChildContent</section>
        break;
    case NTAnimationTag.Article:
        <article @attributes="WrapperAttributes" @ref="Element">@ChildContent</article>
        break;
    case NTAnimationTag.UnorderedList:
        <ul @attributes="WrapperAttributes" @ref="Element">@ChildContent</ul>
        break;
    case NTAnimationTag.OrderedList:
        <ol @attributes="WrapperAttributes" @ref="Element">@ChildContent</ol>
        break;
    case NTAnimationTag.ListItem:
        <li @attributes="WrapperAttributes" @ref="Element">@ChildContent</li>
        break;
    default:
        <div @attributes="WrapperAttributes" @ref="Element">@ChildContent</div>
        break;
}
@if (UsesObserver) {
    @PageScript
}
